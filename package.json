{
  "name": "qa-portfolio-cypress",
  "version": "1.0.0",
  "description": "Portfólio de QA - Testes E2E (Cypress), testes de API e BDD (Gherkin)",
  "scripts": {
    "cy:open": "cypress open --browser electron",
    "cy:run": "cypress run --reporter mochawesome --reporter-options reportDir=cypress/reports/mocha,overwrite=false,html=false,json=true",
    "cy:run:allure": "cypress run --env allure=true --reporter mochawesome --reporter-options reportDir=cypress/reports/mocha,overwrite=false,html=false,json=true",
    "cy:run:api": "cypress run --spec \"cypress/e2e/api/**/*.cy.js\"",
    "cy:run:e2e": "cypress run --spec \"cypress/e2e/ecommerce/**/*.cy.js\"",
    "cy:run:bdd": "cypress run --spec \"cypress/e2e/**/*.feature\"",
    "clean:reports": "rimraf cypress/reports allure-results allure-report",
    "report:merge": "mochawesome-merge cypress/reports/mocha/*.json > cypress/reports/output.json",
    "report:generate": "marge cypress/reports/output.json -f report -o cypress/reports/html",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "report": "npm run clean:reports && npm run cy:run && npm run report:merge && npm run report:generate",
    "report:allure": "npm run clean:reports && npm run cy:run:allure && npm run report:merge && npm run report:generate && npm run allure:generate",
    "report:ci": "npm run report:allure",
    "report:open": "start cypress/reports/html/report.html",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "cypress": "^13.13.0",
    "rimraf": "^5.0.5",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "@badeball/cypress-cucumber-preprocessor": "^20.1.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.2",
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "allure-commandline": "^2.34.1"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/bdd/step_definitions/**/*.js"
  }
}
